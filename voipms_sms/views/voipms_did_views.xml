<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="voipms_did_view_list" model="ir.ui.view">
        <field name="name">voipms.did.list</field>
        <field name="model">voipms.did</field>
        <field name="arch" type="xml">
            <list string="DIDs">
                <field name="number" />
                <field name="label" />
                <field name="sms_available" />
                <field name="sms_enabled" />
                <field name="synced" />
            </list>
        </field>
    </record>

    <record id="voipms_did_view_form" model="ir.ui.view">
        <field name="name">voipms.did.form</field>
        <field name="model">voipms.did</field>
        <field name="arch" type="xml">
            <form string="DID">
                <header>
                    <button
                        name="action_sync_from_provider"
                        type="object"
                        string="Synchroniser depuis VoIP.ms"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="number" />
                        <field name="label" />
                        <field name="sms_available" />
                        <field name="sms_enabled" />
                        <field name="synced" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voipms_did" model="ir.actions.act_window">
        <field name="name">DIDs</field>
        <field name="res_model">voipms.did</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
