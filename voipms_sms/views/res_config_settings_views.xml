<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="voipms_sms_res_config_settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.voipms.sms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="SMS VoIP.ms"
                    name="voipms_sms"
                    logo="/voipms_sms/static/description/icon.png"
                >
                    <block title="Connexion VoIP.ms">
                        <setting string="Utilisateur API VoIP.ms">
                            <field
                                name="voipms_api_username"
                                placeholder="ex : bvezina"
                            />
                        </setting>
                        <setting string="Token API VoIP.ms">
                            <field
                                name="voipms_api_token"
                                password="True"
                                placeholder="Token du portail VoIP.ms"
                            />
                        </setting>
                        <setting string="Test de connexion">
                            <button
                                name="action_test_voipms_connection"
                                type="object"
                                string="Tester la connexion"
                                class="btn-secondary"
                            />
                            <field
                                name="voipms_connection_ok"
                                widget="boolean_favorite"
                                readonly="1"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
