<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wazo_res_config_settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.wazo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Téléphonie Wazo"
                    name="wazo"
                    groups="wazo_tenant.group_wazo_manager"
                >
                    <block title="Connexion Wazo Platform">
                        <setting string="URL du serveur Wazo">
                            <field
                                name="wazo_url"
                                placeholder="ex : https://wazo.diverse-cite.com"
                            />
                        </setting>
                        <setting string="Token API Wazo">
                            <field
                                name="wazo_api_key"
                                password="True"
                                placeholder="Token API généré dans Wazo"
                            />
                        </setting>
                        <setting string="Certificat TLS">
                            <field name="wazo_ssl_verify" />
                        </setting>
                        <setting string="Tenant (optionnel)">
                            <field
                                name="wazo_tenant_id"
                                placeholder="UUID du tenant, vide si mono-tenant"
                            />
                        </setting>
                        <setting string="Contexte des lignes">
                            <field name="wazo_line_context" placeholder="default" />
                        </setting>
                        <setting string="Langue des messageries vocales">
                            <field name="wazo_voicemail_language" placeholder="fr_CA" />
                        </setting>
                        <setting string="Test de connexion">
                            <button
                                name="action_test_wazo_connection"
                                type="object"
                                string="Tester la connexion"
                                class="btn-secondary"
                            />
                            <field
                                name="wazo_connection_ok"
                                widget="boolean_favorite"
                                readonly="1"
                            />
                        </setting>
                    </block>
                    
                </app>
            </xpath>
        </field>
    </record>
</odoo>
