<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- First-setup wizard: trunk, user, ring group. -->
    <record id="action_wazo_setup_wizard" model="ir.actions.act_window">
        <field name="name">Assistant de configuration</field>
        <field name="res_model">wazo.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="wazo_setup_wizard_form" model="ir.ui.view">
        <field name="name">wazo.setup.wizard.form</field>
        <field name="model">wazo.setup.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="trunk,user,group,done" />
                </header>
                <group invisible="state != 'trunk'" string="Trunk VoIP.ms — relier le Wazo au RTC">
                    <group>
                        <field name="protocol" />
                        <field name="pop_host" />
                    </group>
                    <group>
                        <field name="voipms_username" />
                        <field name="voipms_password" password="True" />
                    </group>
                </group>
                <group invisible="state != 'user'" string="Premier usager — un poste qui sonne">
                    <group>
                        <field name="user_name" />
                        <field name="user_extension" />
                    </group>
                </group>
                <group invisible="state != 'group'" string="Premier groupe d'appel — sonnerie groupée">
                    <group>
                        <field name="group_name" />
                        <field name="group_extension" />
                    </group>
                    <div class="text-muted">
                        Le groupe naît avec l'usager créé comme premier
                        membre — modifiable après.
                    </div>
                </group>
                <group invisible="state != 'done'" string="Terminé">
                    <div class="text-success">
                        <h4>La téléphonie est en place.</h4>
                        <p>Le trunk est provisionné, l'usager a son poste, le
                        groupe sonne chez lui. Routez un DID vers le groupe
                        (SMS VoIP.ms → DIDs) pour recevoir les appels.</p>
                    </div>
                    <group>
                        <field name="trunk_id" readonly="1" />
                        <field name="user_id" readonly="1" />
                        <field name="group_id" readonly="1" />
                    </group>
                </group>
                <footer>
                    <button name="action_back" type="object" string="Retour"
                            class="btn-secondary" invisible="state == 'trunk'" />
                    <button name="action_continue" type="object"
                            string="Continuer" class="btn-primary"
                            invisible="state == 'done'" />
                    <button name="action_close" type="object" string="Fermer"
                            class="btn-secondary" invisible="state != 'done'" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
