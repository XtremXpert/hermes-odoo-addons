<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wazo_server_tenant_view_list" model="ir.ui.view">
        <field name="name">wazo.server.tenant.list</field>
        <field name="model">wazo.server.tenant</field>
        <field name="arch" type="xml">
            <list string="Tenants Wazo">
                <field name="name"/>
                <field name="slug"/>
                <field name="context_name"/>
                <field name="parent_id"/>
                <field name="admin_username"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'created'"
                       decoration-warning="state == 'new'"
                       decoration-danger="state == 'error'"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="wazo_server_tenant_view_form" model="ir.ui.view">
        <field name="name">wazo.server.tenant.form</field>
        <field name="model">wazo.server.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant Wazo">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,created,error"/>
                    <button name="action_create_on_wazo" type="object"
                            string="Créer sur Wazo"
                            class="oe_highlight"
                            invisible="state != 'new'"
                            help="Crée le tenant, son contexte et ses plages, puis son administrateur et son jeton."/>
                    <button name="action_delete_on_wazo" type="object"
                            string="Supprimer le tenant"
                            class="btn-danger"
                            invisible="state != 'created'"
                            confirm="Supprimer ce tenant sur Wazo, avec son contexte, son administrateur et ses postes ?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Tenant">
                            <field name="name"/>
                            <field name="slug"
                                   help="Lettres non accentuées, chiffres et « _ », 10 caractères au maximum."/>
                            <field name="parent_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contexte et plages">
                            <field name="context_name"/>
                            <field name="remote_context_name"/>
                            <field name="context_id"/>
                            <field name="user_range_start"/>
                            <field name="user_range_end"/>
                            <field name="group_range_start"/>
                            <field name="group_range_end"/>
                        </group>
                    </group>
                    <group string="Accès du tenant"
                           groups="wazo_phone.group_wazo_manager">
                        <field name="admin_username"/>
                        <field name="admin_password" password="True"/>
                        <field name="api_token" password="True"/>
                        <field name="token_expires_at"/>
                    </group>
                    <group string="Références Wazo">
                        <field name="remote_uuid"/>
                        <field name="admin_user_uuid"/>
                    </group>
                    <group string="Dernier message d'erreur"
                           invisible="state != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wazo_server_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">wazo.server.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
