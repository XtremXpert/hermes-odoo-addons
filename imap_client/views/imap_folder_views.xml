<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="imap_folder_view_list" model="ir.ui.view">
        <field name="model">imap.folder</field>
        <field name="arch" type="xml">
            <list string="Dossiers">
                <field name="account_id"/>
                <field name="name"/>
                <field name="unread"/>
            </list>
        </field>
    </record>
    <record id="action_imap_folder" model="ir.actions.act_window">
        <field name="name">Dossiers</field>
        <field name="res_model">imap.folder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
