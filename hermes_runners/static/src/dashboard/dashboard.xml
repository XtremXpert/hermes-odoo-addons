<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="hermes_runners.Dashboard">
        <div class="o_arc_runners p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="mb-0">Runners GitHub Actions</h4>
                <button
                    class="btn btn-sm btn-secondary"
                    t-on-click="reload"
                    t-att-disabled="state.loading"
                >
                    Rafraîchir
                </button>
            </div>

            <t t-if="state.error">
                <div class="alert alert-danger" t-esc="state.error" />
            </t>

            <t t-if="state.data">
                <div class="text-muted small mb-3">
                    Instantané du <t t-esc="state.data.generated_at" /> —
                    <t t-esc="state.data.totals.runners" /> runner(s),
                    <t t-esc="state.data.totals.saturated" /> pool(s) saturé(s)
                </div>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Cluster</th>
                            <th>Pool</th>
                            <th>Phase</th>
                            <th>ID GitHub</th>
                            <th>Âge</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="state.data.runners"
                            t-as="runner"
                            t-key="runner.name"
                        >
                            <td t-esc="runner.cluster" />
                            <td t-esc="runner.pool" />
                            <td
                                t-att-class="phaseClass(runner.phase)"
                                t-esc="runner.phase"
                            />
                            <td t-esc="runner.runner_id" />
                            <td>
                                <t t-esc="runner.age_minutes" /> min
                            </td>
                        </tr>
                        <tr t-if="!state.data.runners.length">
                            <td colspan="5" class="text-center text-muted">
                                Aucun runner actif. Un job en file n'a pas encore de pod :
                                cette table ne montre que les jobs attribués.
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h5 class="mt-4">Pools</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Pool</th>
                            <th>Dépôt</th>
                            <th>Occupation</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="state.data.clusters"
                            t-as="cluster"
                            t-key="cluster.cluster"
                        >
                            <t t-foreach="cluster.pools" t-as="pool" t-key="pool.name">
                                <tr>
                                    <td t-esc="pool.name" />
                                    <td t-esc="pool.repo" />
                                    <td t-att-class="pool.saturated ? 'o_arc_bad' : ''">
                                        <t t-esc="pool.running" /> / <t
                                        t-esc="pool.max"
                                    />
                                        <t t-if="pool.paused"> (en pause)</t>
                                    </td>
                                </tr>
                            </t>
                        </tr>
                    </tbody>
                </table>
            </t>

            <div t-if="state.loading" class="text-muted">Chargement…</div>
        </div>
    </t>
</templates>
