<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="proxmox_tenant_view_list" model="ir.ui.view">
        <field name="model">proxmox.tenant</field>
        <field name="arch" type="xml">
            <list string="Tenants">
                <field name="name"/>
                <field name="server_id"/>
                <field name="pool_name"/>
                <field name="remote_created"/>
                <field name="members"/>
            </list>
        </field>
    </record>
    <record id="proxmox_tenant_view_form" model="ir.ui.view">
        <field name="model">proxmox.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>
                    <button name="action_creer_pool" type="object" string="Créer le pool"
                            invisible="remote_created"/>
                    <button name="action_lire_membres" type="object" string="Relire les membres"/>
                    <button name="action_supprimer_pool" type="object" string="Supprimer le pool"
                            confirm="Supprimer le pool sur le serveur ? (il doit être vide)"/>
                    <button name="action_creer_serveur" type="object" string="Fiche serveur du tenant"
                            invisible="not remote_created"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="server_id"/>
                        </group>
                        <group>
                            <field name="pool_name"/>
                            <field name="remote_created"/>
                            <field name="members"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_proxmox_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">proxmox.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
