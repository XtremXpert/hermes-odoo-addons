<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Directory views use our controllers: files dropped on a card or a
         row land in THAT directory (see directory_views.esm). -->
    <record id="view_dms_directory_kanban_drop" model="ir.ui.view">
        <field name="name">dms_directory.kanban.drop</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">directory_kanban</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_dms_directory_list_drop" model="ir.ui.view">
        <field name="name">dms_directory.tree.drop</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">directory_list</attribute>
            </xpath>
        </field>
    </record>
</odoo>
