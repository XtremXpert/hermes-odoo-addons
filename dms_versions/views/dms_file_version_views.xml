<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_dms_file_version_list" model="ir.ui.view">
        <field name="name">dms.file.version.list</field>
        <field name="model">dms.file.version</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="display_label" string="Version" />
                <field name="mimetype" string="Type" />
                <field name="size" string="Taille" widget="filesize" />
                <field name="origin" string="Origine" widget="badge"
                       decoration-info="origin == 'update'"
                       decoration-warning="origin == 'restore'" />
                <field name="create_uid" string="Archivée par" />
                <field name="create_date" string="Archivée le" />
                <button name="action_restore" type="object" string="Restaurer"
                        icon="history" confirm="Restaurer ce contenu ? Le contenu actuel sera archivé comme nouvelle version." />
            </list>
        </field>
    </record>

    <record id="view_dms_file_version_form" model="ir.ui.view">
        <field name="name">dms.file.version.form</field>
        <field name="model">dms.file.version</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_label" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="file_id" />
                            <field name="name" />
                            <field name="mimetype" />
                            <field name="extension" />
                        </group>
                        <group>
                            <field name="size" widget="filesize" />
                            <field name="checksum" />
                            <field name="origin" />
                            <field name="create_uid" string="Archivée par" />
                            <field name="create_date" string="Archivée le" />
                        </group>
                    </group>
                    <field name="content" filename="name" readonly="1" />
                    <div class="oe_button_box" name="button_box">
                        <button name="action_restore" type="object" string="Restaurer cette version"
                                class="oe_highlight"
                                confirm="Restaurer ce contenu ? Le contenu actuel sera archivé comme nouvelle version." />
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
