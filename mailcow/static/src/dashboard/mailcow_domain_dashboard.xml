<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Un domaine a la fois. Memes regles d'OWL 3 que le tableau d'ensemble :
         l'etat passe par « proxy », et tout ce qui appartient au composant se
         qualifie par « this. » — une reference nue ne trouve rien. -->
    <t t-name="mailcow.DashboardDomaine">
        <div class="o_mailcow_dashboard p-3">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <button
                        class="btn btn-link p-0 mb-1"
                        t-on-click="() => this.retour()"
                    >
                        <i class="oi me-1" data-icon="arrow_back" />Tous les domaines
                    </button>
                    <h2 class="mb-1">
                        <span t-out="this.donnees.nom" />
                        <span
                            t-if="this.identite.actif"
                            class="badge text-bg-success"
                        >Actif</span>
                        <span t-else="" class="badge text-bg-secondary">Inactif</span>
                        <span
                            t-if="this.identite.synced"
                            class="badge text-bg-info"
                        >Synchronisé</span>
                        <span
                            t-else=""
                            class="badge text-bg-warning"
                        >Jamais synchronisé</span>
                        <span
                            t-if="this.identite.dkim"
                            class="badge text-bg-success"
                        >DKIM enregistré</span>
                        <span t-else="" class="badge text-bg-warning">Sans DKIM</span>
                    </h2>
                    <p
                        t-if="this.identite.description"
                        class="text-muted mb-0"
                        t-out="this.identite.description"
                    />
                </div>
                <div class="d-flex gap-2">
                    <a
                        t-if="this.lienMailcow"
                        class="btn btn-link"
                        t-att-href="this.lienMailcow"
                        target="_blank"
                        rel="noreferrer"
                    >Ouvrir Mailcow</a>
                    <button
                        class="btn btn-secondary"
                        t-on-click="() => this.synchroniser()"
                        t-att-disabled="this.state.synchro"
                    >
                        <t t-if="this.state.synchro">Synchronisation…</t>
                        <t t-else="">Synchroniser ce domaine</t>
                    </button>
                </div>
            </div>

            <!-- Le rafraichissement ne relit que l'etat local d'Odoo : il ne
                 pese pas sur Mailcow. Tirer du serveur reste un geste explicite. -->
            <div
                class="d-flex align-items-center gap-3 border rounded p-2 mb-3 bg-light"
            >
                <div class="form-check form-switch mb-0">
                    <input
                        id="mailcow_auto_domaine"
                        class="form-check-input"
                        type="checkbox"
                        t-att-checked="this.state.auto"
                        t-on-change="() => (this.state.auto = !this.state.auto)"
                    />
                    <label class="form-check-label" for="mailcow_auto_domaine">
                        Rafraîchir tout seul, toutes les 30 secondes
                    </label>
                </div>
                <span class="text-muted small">Dernière mise à jour : <span
                    t-out="this.heureMaj"
                /></span>
                <span t-if="this.identite.derniere_synchro" class="text-muted small">
                    Dernière synchronisation : <span
                    t-out="this.identite.derniere_synchro"
                />
                </span>
                <button
                    class="btn btn-sm btn-link p-0"
                    t-on-click="() => this.charger()"
                >
                    Rafraîchir maintenant
                </button>
            </div>

            <p
                t-if="this.state.chargement &amp;&amp; !this.state.donnees"
            >Chargement…</p>
            <div
                t-elif="this.state.erreur"
                class="alert alert-danger"
                t-out="this.state.erreur"
            />
            <t t-else="">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Boîtes</div>
                            <div class="fs-3" t-out="this.textePlafond" />
                            <div
                                t-if="this.chiffres.boites_max"
                                class="progress mt-1"
                                style="height: 0.5rem;"
                            >
                                <div
                                    t-att-class="this.classeOccupation(this.pourcentagePlafond)"
                                    t-att-style="this.largeur(this.pourcentagePlafond)"
                                />
                            </div>
                            <div
                                t-if="this.chiffres.boites_sans_quota"
                                class="text-muted small"
                            >
                                <span
                                t-out="this.chiffres.boites_sans_quota"
                            /> sans quota
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Alias</div>
                            <div class="fs-3" t-out="this.chiffres.alias" />
                            <div
                                t-if="this.chiffres.alias_max"
                                class="text-muted small"
                            >
                                sur <span t-out="this.chiffres.alias_max" /> permis
                            </div>
                            <div
                                t-else=""
                                class="text-muted small"
                            >aucun plafond fixé</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Messages</div>
                            <div
                                class="fs-3"
                                t-out="this.nombre(this.chiffres.messages)"
                            />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Espace consommé</div>
                            <div
                                class="fs-3"
                                t-out="this.taille(this.chiffres.espace_utilise_mb)"
                            />
                            <div class="text-muted small">
                                sur <t
                                t-out="this.taille(this.chiffres.espace_alloue_mb)"
                            /> alloués
                            </div>
                        </div>
                    </div>
                </div>

                <h4 t-if="this.alertes.length" class="mb-2">
                    À regarder ici
                    <span class="badge text-bg-secondary" t-out="this.alertes.length" />
                </h4>
                <p t-else="" class="text-success">
                    Rien à signaler sur ce domaine.
                </p>
                <div class="row g-2 mb-3">
                    <div
                        class="col-md-6 col-xl-4"
                        t-foreach="this.alertes"
                        t-as="alerte"
                        t-key="alerte.cle"
                    >
                        <button
                            class="card w-100 text-start p-2 h-100 border-0 shadow-sm"
                            t-on-click="() => this.ouvrirAlerte(alerte)"
                        >
                            <div class="d-flex align-items-center gap-2">
                                <span
                                    t-att-class="'badge fs-5 ' + this.classeGravite(alerte.gravite)"
                                    t-out="alerte.nombre"
                                />
                                <span class="fw-semibold" t-out="alerte.libelle" />
                            </div>
                            <div class="text-muted small mt-1" t-out="alerte.detail" />
                        </button>
                    </div>
                </div>
                <p t-if="this.informations.length" class="small text-muted mb-3">
                    <i class="oi me-1" data-icon="info" />
                    <t t-foreach="this.informations" t-as="info" t-key="info.cle">
                        <a
                            href="#"
                            class="me-3"
                            t-on-click.prevent="() => this.ouvrirAlerte(info)"
                        >
                            <t t-out="info.nombre" />
                            <t t-out="info.libelle.toLowerCase()" />
                        </a>
                    </t>
                </p>

                <ul class="nav nav-tabs">
                    <li
                        class="nav-item"
                        t-foreach="this.onglets"
                        t-as="onglet"
                        t-key="onglet.cle"
                    >
                        <a
                            href="#"
                            t-att-class="'nav-link' + (this.state.onglet === onglet.cle ? ' active' : '')"
                            t-on-click.prevent="() => this.changerOnglet(onglet.cle)"
                        >
                            <t t-out="onglet.libelle" />
                            <span
                                class="badge text-bg-secondary"
                                t-out="onglet.nombre"
                            />
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3 my-2">
                    <input
                        type="search"
                        class="form-control"
                        style="max-width: 22rem"
                        placeholder="Rechercher…"
                        t-att-value="this.state.recherche"
                        t-on-input="(ev) => (this.state.recherche = ev.target.value)"
                    />
                    <span class="text-muted small" t-out="this.nombreAffiche" />
                    <button
                        t-if="this.state.recherche"
                        class="btn btn-sm btn-link p-0"
                        t-on-click="() => (this.state.recherche = '')"
                    >Effacer</button>
                </div>

                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr t-if="this.state.onglet === 'boites'">
                            <th role="button" t-on-click="() => this.trierPar('nom')">
                                Adresse<t t-out="this.marqueTri('nom')" /></th>
                            <th
                                role="button"
                                t-on-click="() => this.trierPar('quota_utilise_mb')"
                            >
                                Utilisé<t
                                t-out="this.marqueTri('quota_utilise_mb')"
                            /></th>
                            <th
                                role="button"
                                t-on-click="() => this.trierPar('pourcentage')"
                            >
                                Quota<t t-out="this.marqueTri('pourcentage')" /></th>
                            <th
                                role="button"
                                t-on-click="() => this.trierPar('messages')"
                            >
                                Messages<t t-out="this.marqueTri('messages')" /></th>
                            <th
                                role="button"
                                t-on-click="() => this.trierPar('derniere_connexion')"
                            >
                                Dernière connexion<t
                                t-out="this.marqueTri('derniere_connexion')"
                            /></th>
                            <th>État</th>
                        </tr>
                        <tr t-else="">
                            <th role="button" t-on-click="() => this.trierPar('nom')">
                                Adresse<t t-out="this.marqueTri('nom')" /></th>
                            <th
                                role="button"
                                t-on-click="() => this.trierPar('destinations')"
                            >
                                Destinations<t
                                t-out="this.marqueTri('destinations')"
                            /></th>
                            <th>Attrape-tout</th>
                            <th>État</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="!this.lignes.length">
                            <td
                                t-att-colspan="this.state.onglet === 'boites' ? 6 : 4"
                                class="text-muted"
                            >Aucune ligne.</td>
                        </tr>
                        <tr
                            t-foreach="this.lignes"
                            t-as="ligne"
                            t-key="ligne.id"
                            class="cursor-pointer"
                            t-on-click="() => this.ouvrirFiche(this.modeleOnglet, ligne.id)"
                        >
                            <t t-if="this.state.onglet === 'boites'">
                                <td class="fw-semibold" t-out="ligne.nom" />
                                <td t-out="this.taille(ligne.quota_utilise_mb)" />
                                <td>
                                    <div
                                        t-if="ligne.pourcentage !== null"
                                        class="progress"
                                        style="min-width: 6rem; height: 0.6rem;"
                                    >
                                        <div
                                            t-att-class="this.classeOccupation(ligne.pourcentage)"
                                            t-att-style="this.largeur(ligne.pourcentage)"
                                        />
                                    </div>
                                    <span
                                        class="text-muted small"
                                        t-out="this.texteTaux(ligne.pourcentage)"
                                    />
                                    <span
                                        t-if="ligne.quota_mb"
                                        class="text-muted small"
                                    >
                                        de <t t-out="this.taille(ligne.quota_mb)" />
                                    </span>
                                </td>
                                <td t-out="this.nombre(ligne.messages)" />
                                <td t-out="ligne.derniere_connexion || 'jamais'" />
                                <td>
                                    <span
                                        t-if="ligne.active"
                                        class="badge text-bg-success"
                                    >Active</span>
                                    <span
                                        t-else=""
                                        class="badge text-bg-secondary"
                                    >Désactivée</span>
                                    <span
                                        t-if="!ligne.synced"
                                        class="badge text-bg-warning ms-1"
                                    >Non synchronisée</span>
                                </td>
                            </t>
                            <t t-else="">
                                <td class="fw-semibold" t-out="ligne.nom" />
                                <td t-out="ligne.destinations" />
                                <td>
                                    <span
                                        t-if="ligne.catch_all"
                                        class="badge text-bg-warning"
                                    >attrape-tout</span>
                                    <span t-else="" class="text-muted">—</span>
                                </td>
                                <td>
                                    <span
                                        t-if="ligne.active"
                                        class="badge text-bg-success"
                                    >Actif</span>
                                    <span
                                        t-else=""
                                        class="badge text-bg-secondary"
                                    >Inactif</span>
                                    <span
                                        t-if="!ligne.synced"
                                        class="badge text-bg-warning ms-1"
                                    >Non synchronisé</span>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>

                <div class="row g-3 mt-4">
                    <div class="col-md-4">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Quota par boîte</div>
                            <div t-if="this.identite.quota_mb" class="fs-4">
                                <t t-out="this.taille(this.identite.quota_mb)" />
                            </div>
                            <div t-else="" class="fs-4">illimité</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Dormance</div>
                            <div class="fs-4">
                                <span t-out="this.chiffres.boites_dormantes" /> boîtes
                            </div>
                            <div
                                class="text-muted small"
                            >sans connexion depuis 90 jours</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2 h-100">
                            <div class="text-muted small">Alertes</div>
                            <div class="fs-4" t-out="this.chiffres.alertes" />
                            <div class="text-muted small">
                                <span
                                t-out="this.chiffres.boites_serrees"
                            /> au-dessus de 80 %,
                                <span
                                t-out="this.chiffres.boites_desactivees"
                            /> désactivées
                            </div>
                        </div>
                    </div>
                </div>

                <details t-if="this.identite.dkim_enregistrement" class="mt-3">
                    <summary
                        class="text-muted"
                    >Enregistrement DKIM à publier dans le DNS</summary>
                    <pre
                        class="small border rounded p-2 mt-2"
                        t-out="this.identite.dkim_enregistrement"
                    />
                </details>
            </t>
        </div>
    </t>
</templates>
