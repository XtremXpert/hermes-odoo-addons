# Copier en « .env » : odoo-dev lit ces deux cles ici, et nulle part ailleurs.
#
# « master » est volontaire : cet arbre suit la serie 19.5, pas une etiquette de
# version. Le laisser vide ferait retomber odoo-dev sur son defaut (18.0), donc
# sur une autre Odoo que celle des modules.
ODOO_VERSION=master
PYTHON_VERSION=3.12
