# Copier en « .env » : odoo-dev lit ces deux cles ici, et nulle part ailleurs.
#
# La branche 20.0 d'Odoo, celle des modules (master est passee a la serie 20.1).
# Le laisser vide ferait retomber odoo-dev sur son defaut (18.0), donc sur une
# autre Odoo que celle des modules.
ODOO_VERSION=20.0
PYTHON_VERSION=3.12
