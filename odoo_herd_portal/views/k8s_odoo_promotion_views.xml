<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_k8s_odoo_promotion_list" model="ir.ui.view">
        <field name="name">k8s.odoo.promotion.list</field>
        <field name="model">k8s.odoo.promotion</field>
        <field name="arch" type="xml">
            <list
                create="0"
                edit="0"
                delete="0"
                decoration-info="state in ('requested', 'scheduled')"
                decoration-warning="state in ('backing_up', 'deploying', 'upgrading')"
                decoration-success="state == 'done'"
                decoration-danger="state == 'failed'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="name" />
                <field name="production_id" />
                <field name="staging_id" />
                <field name="partner_id" optional="show" />
                <field name="requested_by_id" />
                <field name="requested_by_agent" optional="hide" />
                <field name="confirmed_by_id" />
                <field name="scheduled_at" optional="show" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_k8s_odoo_promotion_form" model="ir.ui.view">
        <field name="name">k8s.odoo.promotion.form</field>
        <field name="model">k8s.odoo.promotion</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_herd_open_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        invisible="state != 'requested'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="requested,backing_up,upgrading,done"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="state != 'requested'"
                    >
                        Only a human approver of the production confirms, here or from the portal
                        (/my/odoo), with the code of their authenticator app or a code sent by e-mail.
                    </div>
                    <group>
                        <group>
                            <field name="production_id" />
                            <field name="staging_id" />
                            <field name="partner_id" />
                            <field name="image" />
                            <field name="production_image" />
                            <field name="previous_image" />
                            <field name="modules" />
                            <field name="modules_install" />
                        </group>
                        <group>
                            <field name="scheduled_at" />
                            <field name="requested_by_id" />
                            <field name="requested_by_agent" />
                            <field name="confirmed_by_id" />
                            <field name="confirmed_at" />
                            <field name="confirm_method" />
                            <field name="backup_id" />
                            <field name="upgrade_id" />
                        </group>
                    </group>
                    <field name="message" invisible="not message" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_k8s_odoo_promotion_search" model="ir.ui.view">
        <field name="name">k8s.odoo.promotion.search</field>
        <field name="model">k8s.odoo.promotion</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_id" />
                <field name="partner_id" />
                <filter
                    name="pending"
                    string="Awaiting confirmation"
                    domain="[('state', '=', 'requested')]"
                />
                <filter
                    name="running"
                    string="In progress"
                    domain="[('state', 'in', ('scheduled', 'backing_up', 'deploying', 'upgrading'))]"
                />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
            </search>
        </field>
    </record>

    <record id="action_k8s_odoo_promotion" model="ir.actions.act_window">
        <field name="name">Promotions to production</field>
        <field name="res_model">k8s.odoo.promotion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_k8s_promotions"
        name="Promotions"
        parent="odoo_herd.menu_k8s_backup_restore"
        action="action_k8s_odoo_promotion"
        sequence="45"
    />
</odoo>
