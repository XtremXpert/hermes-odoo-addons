<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="odoo_herd.S3UploadWidget">
        <div class="o_s3_upload_widget">
            <t t-if="!this.state.success">
                <div class="d-flex align-items-center gap-2">
                    <input
                        type="file"
                        class="form-control"
                        t-on-change="this.onFileChange"
                        t-att-disabled="this.state.uploading or !this.uploadUrl"
                    />
                    <t t-if="this.state.uploading">
                        <div
                            class="spinner-border spinner-border-sm text-primary"
                            role="status"
                        >
                            <span class="visually-hidden">Uploading...</span>
                        </div>
                        <span class="text-muted"><t
                            t-out="this.state.progress"
                        />%</span>
                    </t>
                </div>
                <t t-if="this.state.uploading">
                    <div class="progress mt-2" style="height: 20px;">
                        <div
                            class="progress-bar progress-bar-striped progress-bar-animated"
                            role="progressbar"
                            t-att-style="'width: ' + this.state.progress + '%'"
                            t-att-aria-valuenow="this.state.progress"
                            aria-valuemin="0"
                            aria-valuemax="100"
                        >
                            <t t-out="this.state.progress" />%
                        </div>
                    </div>
                </t>
                <t t-if="this.state.error">
                    <div class="alert alert-danger mt-2 mb-0" role="alert">
                        <i class="oi" data-icon="warning" />
                        <t t-out="this.state.error" />
                    </div>
                </t>
                <t t-if="!uploadUrl">
                    <small class="text-muted">Click "Generate Upload URL" first</small>
                </t>
            </t>
            <t t-else="">
                <div class="alert alert-success mb-0" role="alert">
                    <i
                    class="oi"
                    data-icon="check_circle"
                /> File uploaded successfully! Click "Confirm Upload" to register the backup.
                </div>
            </t>
        </div>
    </t>
</templates>
