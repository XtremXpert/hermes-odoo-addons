<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Item systray : bouton téléphone dans la barre système. -->
    <!-- Témoin de style : dans un gabarit, un membre du composant se lit
         **avec « this. »**. Un nom nu n'est pas résolu sur le composant : il
         arrive « undefined » et le client lève « Cannot read properties of
         undefined ». -->
    <t t-name="wazo_phone.SystrayItem">
        <button
            class="o_nav_entry"
            t-att-class="this.buttonClasses"
            t-att-title="this.titleText"
            t-on-click="this.onClick"
            data-hotkey="Alt+Shift+S"
        >
            <i class="oi fs-5" t-att-data-icon="this.icon" t-att-class="{'o_wazo_ringing': this.service.state === 'ringing'}" />
            <span t-if="this.service.state === 'ringing'" class="ms-1">
                <t t-out="this.caller" />
            </span>
        </button>
    </t>

    <!-- Softphone (overlay) : bandeau d'état + onglets (Appel / Journal). -->
    <t t-name="wazo_phone.Softphone">
        <div class="o_wazo_softphone p-3 shadow border rounded">
            <!-- Bandeau d'état + fermeture. -->
            <div class="d-flex align-items-center mb-2">
                <i
                    class="oi me-2"
                    t-att-class="{ 'text-success': this.service.state === 'registered' or this.isInCall or this.isRinging }"
                    t-att-data-icon="this.statusIcon"
                />
                <span class="fw-bold me-auto">
                    <t t-out="this.statusText" />
                </span>
                <button
                    class="btn btn-sm btn-ghost"
                    t-on-click="this.onClose"
                    title.translate="Fermer"
                >
                    <i class="oi" data-icon="close" />
                </button>
            </div>

            <t t-if="this.isUsable">
                <!-- Onglets. -->
                <ul class="nav nav-pills nav-fill mb-2">
                    <li class="nav-item">
                        <a
                            class="nav-link"
                            t-att-class="{ active: this.state.activeTab === 'call' }"
                            href="#"
                            t-att-disabled="this.isInCall or this.isRinging"
                            t-on-click.prevent="this.onTabChange('call')"
                        >
                            Appel
                        </a>
                    </li>
                    <li class="nav-item">
                        <a
                            class="nav-link"
                            t-att-class="{ active: this.state.activeTab === 'log' }"
                            href="#"
                            t-on-click.prevent="this.onTabChange('log')"
                        >
                            Journal
                        </a>
                    </li>
                </ul>

                <!-- Onglet Appel : numéroteur + contrôles + cœur d'appel. -->
                <div t-if="this.state.activeTab === 'call'">
                    <!-- Numéroteur. -->
                    <form class="d-flex mb-2" t-on-submit="this.onCall">
                        <input
                            type="text"
                            class="form-control me-2"
                            placeholder.translate="Extension (ex. 1011)"
                            t-att-value="this.state.target"
                            t-on-input="this.onTargetInput"
                            autocomplete="off"
                        />
                        <button
                            type="submit"
                            class="btn btn-primary"
                            t-att-disabled="this.isInCall or this.isRinging"
                        >
                            <i class="oi me-1" data-icon="phone" />
                            Appeler
                        </button>
                    </form>

                    <!-- Clavier : compose le numéro avant l'appel. -->
                    <div
                        t-if="!(this.isInCall or this.isOutbound or this.isRinging)"
                        class="d-grid gap-1 mb-2"
                        style="grid-template-columns: repeat(3, 1fr);"
                    >
                        <t t-foreach="this.dtmfKeys" t-as="key" t-key="key">
                            <button
                                type="button"
                                class="btn btn-outline-secondary"
                                t-on-click="() => this.onDialKey(key)"
                            >
                                <t t-out="key" />
                            </button>
                        </t>
                    </div>

                    <!-- Contrôles d'appel. -->
                    <div class="d-flex gap-2 flex-wrap">
                        <button
                            t-if="this.isRinging"
                            class="btn btn-success"
                            t-on-click="this.onAnswer"
                        >
                            <i class="oi me-1" data-icon="check" />
                            Répondre
                        </button>
                        <button
                            t-if="this.isInCall or this.isOutbound or this.isRinging"
                            class="btn btn-danger"
                            t-on-click="this.onHangup"
                        >
                            <i class="oi me-1" data-icon="cancel" />
                            Raccrocher
                        </button>
                        <button
                            t-if="this.isInCall"
                            class="btn btn-warning"
                            t-on-click="this.onHoldToggle"
                        >
                            <i
                                class="oi me-1"
                                t-att-data-icon="this.isHeld ? 'phone_in_talk' : 'pause'"
                            />
                            <t t-if="this.isHeld">Reprendre</t>
                            <t t-else="">Mettre en attente</t>
                        </button>
                        <button
                            t-if="this.isInCall"
                            class="btn btn-secondary"
                            t-on-click="this.onMuteToggle"
                        >
                            <i
                                class="oi me-1"
                                t-att-data-icon="this.service.muted ? 'mic_off' : 'mic'"
                            />
                            <t t-if="this.service.muted">Rétablir</t>
                            <t t-else="">Muet</t>
                        </button>
                        <button
                            t-if="this.isInCall"
                            class="btn btn-info"
                            t-on-click="this.onPark"
                        >
                            <i class="oi me-1" data-icon="local_parking" />
                            Parquer
                        </button>
                    </div>

                    <!-- DTMF (en appel). -->
                    <div t-if="this.isInCall" class="mt-2">
                        <form
                            class="d-flex align-items-center gap-2"
                            t-on-submit="this.onSendDtmf"
                        >
                            <input
                                type="text"
                                class="form-control"
                                placeholder.translate="DTMF (ex. 1234*)"
                                t-att-value="this.state.dtmfTones"
                                t-on-input="this.onDtmfInput"
                                autocomplete="off"
                            />
                            <button
                                type="submit"
                                class="btn btn-outline-secondary"
                                t-att-disabled="!this.state.dtmfTones"
                            >
                                <i class="oi me-1" data-icon="dialpad" />
                                Envoyer
                            </button>
                        </form>
                        <div class="d-flex gap-1 mt-1 flex-wrap">
                            <t t-foreach="this.dtmfKeys" t-as="key" t-key="key">
                                <button
                                    class="btn btn-sm btn-outline-secondary flex-fill"
                                    t-on-click="() => this.onDtmfKey(key)"
                                >
                                    <t t-out="key" />
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Transfert (en appel). -->
                    <div t-if="this.isInCall" class="mt-2">
                        <form
                            class="d-flex align-items-center gap-2"
                            t-on-submit="this.onTransfer"
                        >
                            <input
                                type="text"
                                class="form-control"
                                placeholder.translate="Transférer vers (ex. 2000)"
                                t-att-value="this.state.transferTarget"
                                t-on-input="this.onTransferInput"
                                autocomplete="off"
                            />
                            <button
                                type="submit"
                                class="btn btn-outline-primary"
                                t-att-disabled="!this.state.transferTarget"
                            >
                                <i class="oi me-1" data-icon="swap_horiz" />
                                Transférer
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Onglet Journal : journal d'appels (CDR). -->
                <div t-else="">
                    <div t-if="this.callLog.length === 0" class="text-muted small">
                        Aucun appel enregistré.
                    </div>
                    <ul t-else="" class="list-group">
                        <li
                            class="list-group-item py-2"
                            t-foreach="this.callLog"
                            t-as="entry"
                            t-key="entry.id"
                        >
                            <div class="d-flex align-items-center">
                                <i
                                    class="oi me-2"
                                    t-att-class="entry.direction === 'inbound' ? 'text-success' : 'text-primary'"
                                    t-att-data-icon="entry.direction === 'inbound' ? 'arrow_downward' : 'arrow_upward'"
                                />
                                <span class="fw-bold me-auto">
                                    <t t-out="entry.name or entry.num or '—'" />
                                    <small class="text-muted"> (<t
                                        t-out="entry.num"
                                    />)</small>
                                </span>
                                <span
                                    class="badge text-bg-light me-2"
                                    t-out="this.formatDuration(entry.duration)"
                                />
                            </div>
                            <div class="small text-muted">
                                <t t-out="this.formatDateTime(entry.date)" />
                                <t t-if="entry.partner_name"> · <t
                                    t-out="entry.partner_name"
                                /></t>
                                <t t-if="!entry.answered"> · non répondu</t>
                            </div>
                        </li>
                    </ul>
                </div>
            </t>
            <t t-else="">
                <!-- Message de dégradation. -->
                <div class="text-muted small" t-out="this.statusText" />
                <p class="text-muted small mb-0">
                    Synchronisez l’endpoint Wazo de cet utilisateur pour activer les appels.
                </p>
            </t>
        </div>
    </t>

</templates>
