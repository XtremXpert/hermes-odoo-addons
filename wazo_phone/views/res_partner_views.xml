<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form_inherit_wazo" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.wazo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page
                    string="Téléphonie Wazo"
                    name="wazo"
                    groups="wazo_phone.group_wazo_user"
                >
                    <group>
                        <group string="Utilisateur Wazo">
                            <field name="wazo_user_id" readonly="1" />
                            <field name="wazo_extension" />
                            <button
                                name="action_create_wazo_user"
                                type="object"
                                string="Créer utilisateur Wazo"
                                class="btn-secondary"
                                groups="wazo_phone.group_wazo_manager"
                                invisible="wazo_user_id"
                            />
                            <button
                                name="action_open_wazo_user"
                                type="object"
                                string="Ouvrir"
                                class="btn-link"
                                groups="wazo_phone.group_wazo_user"
                                invisible="not wazo_user_id"
                            />
                        </group>
                        <group string="Journal d'appels">
                            <field name="wazo_cdr_count" />
                            <button
                                name="action_open_wazo_cdrs"
                                type="object"
                                string="Voir les appels"
                                class="btn-link"
                                groups="wazo_phone.group_wazo_user"
                                invisible="wazo_cdr_count == 0"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
