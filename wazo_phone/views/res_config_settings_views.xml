<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wazo_res_config_settings_view_phone" model="ir.ui.view">
        <field name="name">res.config.settings.wazo.phone</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wazo_tenant.wazo_res_config_settings_view" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='wazo']" position="inside">
<block
                        title="Softphone (module voip)"
                        help="Nécessite le module « voip » d'Enterprise installé et le transport WebSocket (wss) d'Asterisk sur le serveur Wazo. Sans ces prérequis, la téléphonie fonctionne avec un poste SIP classique."
                    >
                        <setting string="Activer le pont softphone">
                            <field name="wazo_softphone_enabled" />
                        </setting>
                        <setting
                            string="URL WebSocket (wss)"
                            invisible="not wazo_softphone_enabled"
                        >
                            <field
                                name="wazo_ws_url"
                                placeholder="wss://wazo.diverse-cite.com"
                                invisible="not wazo_softphone_enabled"
                            />
                        </setting>
                        <setting
                            string="Domaine SIP (PBX)"
                            invisible="not wazo_softphone_enabled"
                        >
                            <field
                                name="wazo_pbx_domain"
                                placeholder="wazo.diverse-cite.com"
                                invisible="not wazo_softphone_enabled"
                            />
                        </setting>
                        <setting
                            string="Appliquer aux utilisateurs"
                            invisible="not wazo_softphone_enabled"
                        >
                            <button
                                name="action_ensure_voip_provider"
                                type="object"
                                string="Créer le provider et propager les identifiants"
                                class="btn-secondary"
                                invisible="not wazo_softphone_enabled"
                            />
                            <div class="text-muted">
                                Crée (ou met à jour) le provider « Wazo »
                                et réapplique les identifiants SIP des
                                utilisateurs synchronisés.
                            </div>
                        </setting>
                    </block>
            </xpath>
        </field>
    </record>
</odoo>
