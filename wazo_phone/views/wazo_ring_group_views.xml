<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wazo_ring_group_view_list" model="ir.ui.view">
        <field name="name">wazo.ring.group.list</field>
        <field name="model">wazo.ring.group</field>
        <field name="arch" type="xml">
            <list string="Groupes d'appel">
                <field name="name" />
                <field name="extension" />
                <field name="ring_strategy" />
                <field name="member_count" />
                <field
                    name="wazo_state"
                    widget="badge"
                    decoration-success="wazo_state == 'synced'"
                    decoration-warning="wazo_state == 'new'"
                    decoration-danger="wazo_state == 'error'"
                />
                <field name="error_message" optional="hide" />
            </list>
        </field>
    </record>

    <record id="wazo_ring_group_view_form" model="ir.ui.view">
        <field name="name">wazo.ring.group.form</field>
        <field name="model">wazo.ring.group</field>
        <field name="arch" type="xml">
            <form string="Groupe d'appel">
                <header>
                    <field
                        name="wazo_state"
                        widget="statusbar"
                        statusbar_visible="new,synced,error"
                    />
                    <button
                        name="action_sync_wazo"
                        type="object"
                        string="Synchroniser sur Wazo"
                        class="oe_highlight"
                        invisible="wazo_state != 'new'"
                    />
                    <button
                        name="action_retry_sync"
                        type="object"
                        string="Réessayer la synchronisation"
                        class="btn-warning"
                        invisible="wazo_state != 'error'"
                    />
                    <button
                        name="action_delete_wazo"
                        type="object"
                        string="Supprimer les ressources Wazo"
                        class="btn-danger"
                        invisible="wazo_state != 'synced'"
                    />
                </header>
                <sheet>
                    <group>
                        <group string="Groupe">
                            <field name="name" />
                            <field
                                name="extension"
                                help="Numéro du groupe, pris dans la plage des groupes d'appel du contexte Wazo (par ex. 2000-2099)."
                            />
                            <field name="ring_strategy" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Délais">
                            <field name="user_timeout" />
                            <field name="retry_delay" />
                            <field name="timeout" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Membres">
                            <field
                                name="member_ids"
                                help="Utilisateurs qui sonnent, dans l'ordre de leur priorité. Chacun doit être synchronisé sur Wazo au préalable."
                            >
                                <list>
                                    <field name="priority" />
                                    <field name="user_id" />
                                    <field name="extension" />
                                    <field
                                        name="wazo_state"
                                        widget="badge"
                                        decoration-success="wazo_state == 'synced'"
                                        decoration-warning="wazo_state == 'new'"
                                        decoration-danger="wazo_state == 'error'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Références Wazo"
                            groups="wazo_phone.group_wazo_manager"
                        >
                            <group>
                                <field name="remote_group_id" readonly="1" />
                                <field name="remote_extension_id" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                    <group
                        string="Dernier message d'erreur"
                        invisible="wazo_state != 'error'"
                    >
                        <field name="error_message" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wazo_ring_group" model="ir.actions.act_window">
        <field name="name">Groupes d'appel</field>
        <field name="res_model">wazo.ring.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
