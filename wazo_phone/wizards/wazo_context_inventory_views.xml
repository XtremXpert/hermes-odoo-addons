<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wazo_extension_inventory_view_search" model="ir.ui.view">
        <field name="name">wazo.extension.inventory.search</field>
        <field name="model">wazo.extension.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="extension" />
                <field name="attachment_label" />
                <field name="odoo_reference" />
                <filter
                    name="orphelines"
                    string="Orphelines"
                    domain="[('is_orphan', '=', True)]"
                />
                <filter
                    name="sans_fiche_odoo"
                    string="Sans fiche Odoo"
                    domain="[('odoo_reference', '=', False)]"
                />
                <group>
                    <filter
                        name="par_rattachement"
                        string="Rattachement"
                        context="{'group_by': 'attachment_kind'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="wazo_extension_inventory_view_list" model="ir.ui.view">
        <field name="name">wazo.extension.inventory.list</field>
        <field name="model">wazo.extension.inventory</field>
        <field name="arch" type="xml">
            <list
                string="Postes du contexte"
                create="false"
                edit="false"
                delete="false"
                decoration-danger="is_orphan and not in_declared_range"
                decoration-warning="is_orphan and in_declared_range"
            >
                <header>
                    <button
                        name="action_load"
                        type="object"
                        string="Rafraîchir depuis Wazo"
                        class="oe_highlight"
                    />
                </header>
                <field name="extension" />
                <field name="attachment_kind" />
                <field name="attachment_label" />
                <field name="is_orphan" widget="boolean_toggle" />
                <field name="in_declared_range" />
                <field name="odoo_reference" />
                <field name="context" optional="hide" />
            </list>
        </field>
    </record>

    <record id="wazo_extension_inventory_view_form" model="ir.ui.view">
        <field name="name">wazo.extension.inventory.form</field>
        <field name="model">wazo.extension.inventory</field>
        <field name="arch" type="xml">
            <form string="Poste du contexte" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Poste">
                            <field name="extension" />
                            <field name="context" />
                        </group>
                        <group string="Rattachement">
                            <field name="attachment_kind" />
                            <field name="attachment_label" />
                            <field name="is_orphan" />
                            <field name="in_declared_range" />
                            <field name="odoo_reference" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wazo_extension_inventory" model="ir.actions.act_window">
        <field name="name">Postes du contexte</field>
        <field name="res_model">wazo.extension.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Charger l'inventaire du contexte Wazo
            </p>
            <p>
                Les postes sont lus dans Wazo, qui fait autorité : chaque
                chargement remplace ce qui est affiché. Les lignes en
                <span class="text-danger">rouge</span> sont orphelines et hors
                de toute plage — des numéros laissés là, qui occupent pourtant
                la place. Celles en <span class="text-warning">jaune</span>
                sont orphelines mais dans une plage déclarée.
            </p>
        </field>
    </record>
</odoo>
