<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mailcow_domain_view_tree" model="ir.ui.view">
        <field name="name">mailcow.domain.view.tree</field>
        <field name="model">mailcow.domain</field>
        <field name="arch" type="xml">
            <list string="Domaines">
                <header>
                    <button name="action_sync_all_from_mailcow" type="object"
                            string="Synchroniser depuis Mailcow"
                            groups="mailcow_admin.group_mailcow_manager"/>
                </header>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="quota_mb" string="Quota (Mo)" optional="show"/>
                <field name="synced" string="Synchronisé"/>
                <field name="active" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="mailcow_domain_view_form" model="ir.ui.view">
        <field name="name">mailcow.domain.view.form</field>
        <field name="model">mailcow.domain</field>
        <field name="arch" type="xml">
            <form string="Domaine">
                <header>
                    <button name="action_create_on_mailcow" type="object"
                            string="Créer sur Mailcow" class="btn-primary"
                            invisible="synced"
                            groups="mailcow_admin.group_mailcow_user"/>
                    <button name="action_update_on_mailcow" type="object"
                            string="Mettre à jour sur Mailcow"
                            invisible="not synced"
                            groups="mailcow_admin.group_mailcow_user"/>
                    <button name="action_delete_on_mailcow" type="object"
                            string="Supprimer de Mailcow" danger="1"
                            invisible="not synced"
                            groups="mailcow_admin.group_mailcow_manager"
                            confirm="Supprimer ce domaine (et ses boîtes mail et alias) sur le serveur Mailcow ?"/>
                    <button name="action_sync_from_mailcow" type="object"
                            string="Synchroniser depuis Mailcow"
                            groups="mailcow_admin.group_mailcow_manager"/>
                    <button name="action_fetch_dkim" type="object"
                            string="Enregistrement DKIM"
                            invisible="not synced"
                            groups="mailcow_admin.group_mailcow_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Non synchronisé" bgcolor="bg-danger" invisible="synced"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ex. diverse-cite.com"/></h1>
                    </div>
                    <group>
                        <group string="Domaine">
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                        <group string="Mailcow">
                            <field name="synced"/>
                            <field name="quota_mb"/>
                            <field name="dkim_record" widget="text"
                                   invisible="not dkim_record"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Boîtes mail" name="mailboxes">
                            <field name="mailboxes" readonly="1">
                                <list>
                                    <field name="local_part"/>
                                    <field name="name"/>
                                    <field name="quota_mb"/>
                                    <field name="active"/>
                                    <field name="synced"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alias" name="aliases">
                            <field name="aliases" readonly="1">
                                <list>
                                    <field name="alias_name"/>
                                    <field name="active"/>
                                    <field name="synced"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mailcow_domain_view_search" model="ir.ui.view">
        <field name="name">mailcow.domain.view.search</field>
        <field name="model">mailcow.domain</field>
        <field name="arch" type="xml">
            <search string="Domaines">
                <field name="name"/>
                <field name="description"/>
                <filter string="Non synchronisés" name="not_synced" domain="[('synced', '=', False)]"/>
                <separator/>
                <filter string="Archivé" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mailcow_domain" model="ir.actions.act_window">
        <field name="name">Domaines</field>
        <field name="res_model">mailcow.domain</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un domaine ou synchroniser depuis Mailcow
            </p>
            <p>Les domaines créés ici peuvent être poussés vers le serveur Mailcow.</p>
        </field>
    </record>

</odoo>
