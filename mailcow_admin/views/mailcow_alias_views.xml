<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mailcow_alias_view_tree" model="ir.ui.view">
        <field name="name">mailcow.alias.view.tree</field>
        <field name="model">mailcow.alias</field>
        <field name="arch" type="xml">
            <list string="Alias">
                <header>
                    <button name="action_sync_all_from_mailcow" type="object"
                            string="Synchroniser depuis Mailcow"
                            groups="mailcow_admin.group_mailcow_manager"/>
                </header>
                <field name="alias_name"/>
                <field name="is_catch_all" optional="show"/>
                <field name="domain_id"/>
                <field name="address_ids" widget="many2many_tags" optional="show"/>
                <field name="active"/>
                <field name="synced" string="Synchronisé"/>
            </list>
        </field>
    </record>

    <record id="mailcow_alias_view_form" model="ir.ui.view">
        <field name="name">mailcow.alias.view.form</field>
        <field name="model">mailcow.alias</field>
        <field name="arch" type="xml">
            <form string="Alias">
                <header>
                    <button name="action_create_on_mailcow" type="object"
                            string="Créer sur Mailcow" class="btn-primary"
                            invisible="synced"
                            groups="mailcow_admin.group_mailcow_user"/>
                    <button name="action_update_on_mailcow" type="object"
                            string="Mettre à jour sur Mailcow"
                            invisible="not synced"
                            groups="mailcow_admin.group_mailcow_user"/>
                    <button name="action_delete_on_mailcow" type="object"
                            string="Supprimer de Mailcow" danger="1"
                            invisible="not synced"
                            groups="mailcow_admin.group_mailcow_manager"
                            confirm="Supprimer cet alias sur le serveur Mailcow ?"/>
                    <button name="action_sync_from_mailcow" type="object"
                            string="Synchroniser depuis Mailcow"
                            groups="mailcow_admin.group_mailcow_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Non synchronisé" bgcolor="bg-danger" invisible="synced"/>
                    <div class="oe_title">
                        <h1>
                            <field name="alias_name" placeholder="ex. info"/>
                            <span>@</span>
                            <field name="domain_id" placeholder="domaine"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Alias">
                            <field name="is_catch_all"/>
                            <field name="address_ids" widget="many2many_tags"/>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                        <group string="Mailcow">
                            <field name="synced"/>
                            <field name="mailcow_id" invisible="not mailcow_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mailcow_alias_view_search" model="ir.ui.view">
        <field name="name">mailcow.alias.view.search</field>
        <field name="model">mailcow.alias</field>
        <field name="arch" type="xml">
            <search string="Alias">
                <field name="alias_name"/>
                <field name="domain_id"/>
                <filter string="Non synchronisés" name="not_synced" domain="[('synced', '=', False)]"/>
                <separator/>
                <filter string="Archivé" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mailcow_alias" model="ir.actions.act_window">
        <field name="name">Alias</field>
        <field name="res_model">mailcow.alias</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un alias ou synchroniser depuis Mailcow
            </p>
            <p>Un alias redirige vers une ou plusieurs adresses de destination.</p>
        </field>
    </record>

</odoo>
