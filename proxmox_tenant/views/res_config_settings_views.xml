<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_proxmox" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Proxmox"
                    name="proxmox_tenant"
                    data-string="Proxmox"
                >
                    <block title="Serveur Proxmox" name="proxmox_config">
                        <setting
                            string="Connexion"
                            help="URL du cluster et jeton API (Datacenter → Permissions → API Tokens)."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="proxmox_base_url" class="col-lg-4 o_light_label"/>
                                    <field
                                        name="proxmox_base_url"
                                        placeholder="https://pve.exemple.com:8006"
                                    />
                                </div>
                                <div class="row">
                                    <label for="proxmox_api_token" class="col-lg-4 o_light_label"/>
                                    <field
                                        name="proxmox_api_token"
                                        password="True"
                                        placeholder="user@pam!odoo=xxxxxxxx-..."
                                    />
                                </div>
                                <div class="row">
                                    <label for="proxmox_verify_ssl" class="col-lg-4 o_light_label"/>
                                    <field name="proxmox_verify_ssl"/>
                                </div>
                                <div class="row">
                                    <label for="proxmox_allowed_pools" class="col-lg-4 o_light_label"/>
                                    <field
                                        name="proxmox_allowed_pools"
                                        placeholder="diverse,mac"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
