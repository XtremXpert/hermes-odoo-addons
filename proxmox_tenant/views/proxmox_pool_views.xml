<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="proxmox_pool_view_list" model="ir.ui.view">
        <field name="model">proxmox.pool</field>
        <field name="arch" type="xml">
            <list string="Pools">
                <field name="name"/>
                <field name="description"/>
                <field name="members"/>
                <field name="last_synced_on"/>
            </list>
        </field>
    </record>
    <record id="action_proxmox_pool" model="ir.actions.act_window">
        <field name="name">Pools</field>
        <field name="res_model">proxmox.pool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
