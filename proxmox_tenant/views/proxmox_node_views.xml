<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="proxmox_node_view_list" model="ir.ui.view">
        <field name="model">proxmox.node</field>
        <field name="arch" type="xml">
            <list string="Noeuds">
                <field name="name"/>
                <field name="status"/>
                <field name="cpu" widget="progressbar"/>
                <field name="mem_max"/>
                <field name="disk_max"/>
                <field name="last_synced_on"/>
            </list>
        </field>
    </record>
    <record id="proxmox_node_view_form" model="ir.ui.view">
        <field name="model">proxmox.node</field>
        <field name="arch" type="xml">
            <form string="Noeud">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="status"/>
                            <field name="uptime"/>
                        </group>
                        <group>
                            <field name="cpu"/>
                            <field name="mem_used"/>
                            <field name="mem_max"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="disk_used"/>
                            <field name="disk_max"/>
                        </group>
                        <group>
                            <field name="last_synced_on"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_proxmox_node" model="ir.actions.act_window">
        <field name="name">Noeuds</field>
        <field name="res_model">proxmox.node</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
