<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="proxmox_server_view_list" model="ir.ui.view">
        <field name="model">proxmox.server</field>
        <field name="arch" type="xml">
            <list string="Serveurs">
                <field name="name"/>
                <field name="url"/>
                <field name="allowed_pools"/>
                <field name="verify_ssl"/>
            </list>
        </field>
    </record>
    <record id="proxmox_server_view_form" model="ir.ui.view">
        <field name="model">proxmox.server</field>
        <field name="arch" type="xml">
            <form string="Serveur">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="api_token" password="True"/>
                            <field name="verify_ssl"/>
                            <field name="allowed_pools"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_proxmox_server" model="ir.actions.act_window">
        <field name="name">Serveurs</field>
        <field name="res_model">proxmox.server</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
