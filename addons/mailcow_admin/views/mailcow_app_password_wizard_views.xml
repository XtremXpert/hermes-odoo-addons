<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mailcow_app_password_wizard_form" model="ir.ui.view">
        <field name="name">mailcow.app.password.wizard.form</field>
        <field name="model">mailcow.app.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Nouveau mot de passe applicatif">
                <group>
                    <field name="mailbox_id" readonly="1"/>
                    <field name="app_name" placeholder="wordpress, telephone, scanner..."/>
                    <field name="protocols"/>
                </group>
                <footer>
                    <button name="action_create_app_password" type="object"
                            string="Créer et montrer le mot de passe" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
