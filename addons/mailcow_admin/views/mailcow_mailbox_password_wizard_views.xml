<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mailcow_mailbox_password_view_form" model="ir.ui.view">
        <field name="name">mailcow.mailbox.password.view.form</field>
        <field name="model">mailcow.mailbox.password</field>
        <field name="arch" type="xml">
            <form string="Changer le mot de passe">
                <group>
                    <field name="mailbox_id" readonly="1"/>
                    <field name="password" password="True" placeholder="Nouveau mot de passe"/>
                    <field name="confirm" password="True" placeholder="Confirmer le mot de passe"/>
                </group>
                <footer>
                    <button name="action_reset" string="Changer" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mailcow_mailbox_password" model="ir.actions.act_window">
        <field name="name">Changer le mot de passe</field>
        <field name="res_model">mailcow.mailbox.password</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_mailcow_mailbox"/>
        <field name="binding_view_types">form</field>
        <field name="binding_type">action</field>
    </record>

</odoo>
