    Menu structure (all admin-only via group_diverse_mail_gateway_admin):

        Settings
          └─ Technical
              └─ Mail Gateway
                  ├─ Tokens         (list of diverse.mail_gateway.token)
                  └─ Generate Token (opens the wizard)
-->
<odoo>
    <menuitem
        id="menu_diverse_mail_gateway"
        name="Mail Gateway"
        parent="base.menu_custom"
        sequence="10"
        groups="group_diverse_mail_gateway_admin"
    />

    <menuitem
        id="menu_diverse_mail_gateway_tokens"
        name="Tokens"
        parent="menu_diverse_mail_gateway"
        action="action_diverse_mail_gateway_token"
        sequence="10"
    />

    <menuitem
        id="menu_diverse_mail_gateway_generate"
        name="Generate Token"
        parent="menu_diverse_mail_gateway"
        action="action_token_create_wizard"
        sequence="20"
    />
</odoo>
